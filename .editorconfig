# Indentation follows each language's standard tooling (gofmt, Spotless, swift-format),
# so that formatters and linters in CI agree with what editors produce.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{java,kt,swift}]
indent_size = 4

# gofmt mandates tabs; any other setting is rewritten on save.
[*.go]
indent_style = tab
indent_size = 4

[{Makefile,*.mk}]
indent_style = tab
indent_size = 4

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false
